rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // Helper Functions
    // =========================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // True if the signed-in user's own user doc (users/{uid}.storeId) matches storeId,
    // i.e. they are the vendor who owns that store.
    function isStoreOwner(storeId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeId == storeId;
    }

    // =========================
    // ADMIN SETTINGS
    // =========================
    match /admin_settings/{document} {
      allow read, write: if true;
    }
    
    match /global_settings/{document} {
      allow read, write: if true;
    }

    // =========================
    // USERS
    // =========================

    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /followingStores/{storeId} {
        allow read, write: if isOwner(userId);
      }
    }

    // =========================
    // CUSTOMERS
    // =========================

    match /customers/{userId} {
      allow read, write: if isOwner(userId);
    }

    // =========================
    // SUPPLIER APPLICATIONS
    // =========================

    match /supplierApplications/{applicationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // =========================
    // BANK UPDATE REQUESTS
    // =========================

    match /bankUpdateRequests/{requestId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // =========================
    // SEEDER ALLOWED COLLECTIONS
    // =========================
    // WARNING: These collections are temporarily set to `allow write: if true;` 
    // to allow the development seeder to work from the client app. 
    // Revert these to secure rules before deploying to production!

    match /stores/{storeId} {
      allow read, write: if true; 
      
      match /followers/{userId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /categories/{document} {
      allow read, write: if true;
    }

    match /subcategories/{document} {
      allow read, write: if true;
    }

    match /sub_categories/{document} {
      allow read, write: if true;
    }

    match /tags/{document} {
      allow read, write: if true;
    }

    match /banners/{document} {
      allow read, write: if true;
    }

    match /collections/{document} {
      allow read, write: if true;
    }

    match /home_sections/{document} {
      allow read, write: if true;
    }

    match /trust_features/{document} {
      allow read, write: if true;
    }

    match /store_updates/{document} {
      allow read, write: if true;
    }

    match /appConfig/{document} {
      allow read, write: if true;
    }

    // =========================
    // ORDERS
    // =========================

    match /orders/{orderId} {
      allow create: if isAuthenticated();
      // Only the customer who placed the order or the vendor whose store it belongs to
      // may read/update it — previously any signed-in user could touch any order.
      allow read, update: if isAuthenticated() &&
        (resource.data.customerId == request.auth.uid || isStoreOwner(resource.data.storeId));
      allow delete: if false;
    }

    // =========================
    // FOLLOWERS
    // =========================

    match /followers/{followId} {
      allow read, write: if isAuthenticated();
    }

    // =========================
    // TRANSACTIONS & PAYOUTS
    // =========================

    // NOTE: left as-is — this collection isn't read or written anywhere in the vendor
    // app, so its real document schema/owner field couldn't be confirmed here. Scope
    // this the same way as `payouts` once that's verified against whatever app writes it.
    match /transactions/{transactionId} {
      allow read, write: if isAuthenticated();
    }

    match /payouts/{payoutId} {
      // Scoped to the vendor whose store the payout belongs to — previously any
      // signed-in user could read or write any store's payout records.
      allow read: if isStoreOwner(resource.data.storeId);
      allow write: if isStoreOwner(request.resource.data.storeId);
    }

    // =========================
    // REFUND REQUESTS
    // =========================

    match /refund_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // =========================
    // REPORTS & MODERATION
    // =========================

    match /reports/{reportId} {
      allow read, write: if true; // Allows customers to submit store/product reports & Admin to moderate
    }
  }
}
